# =============================================
# Google Calendar Integration
# =============================================
# Follow these steps to get these values:
# 1. Go to https://console.cloud.google.com
# 2. Create a project (or select existing one)
# 3. Enable "Google Calendar API" from the API Library
# 4. Go to Credentials → Create Credentials → Service Account
# 5. Download the JSON key file
# 6. Copy the values below from the downloaded JSON file
# 7. IMPORTANT: Share your Google Calendar with the service account email
#    (Go to Google Calendar → Settings → Share with specific people → Add the service account email with "Make changes to events" permission)

# The "client_email" field from your Service Account JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The "private_key" field from your Service Account JSON key
# Keep the entire key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Your Google Calendar ID (usually your Gmail address, or a specific calendar ID)
# To find it: Google Calendar → Settings → Calendar settings → "Integrate calendar" → Calendar ID
GOOGLE_CALENDAR_ID=your-email@gmail.com
